<!DOCTYPE html>
<html lang="cs">
<head>
  <meta charset="UTF-8" />
  <title>Centrální čas závodu</title>

  <!-- Základní styl, aby byl čas dobře čitelný -->
<style>
  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background-color: #111;
    color: #00ff00;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }

  #container {
    width: 100%;
    max-width: 400px;
    text-align: center;
  }

  #time {
    font-size: 3rem;
    margin-bottom: 20px;
  }

  #controls {
    margin-bottom: 20px;
  }

  input {
    width: 100%;
    padding: 10px;
    font-size: 1.2rem;
    margin-bottom: 10px;
  }

  .buttons {
    display: flex;
    gap: 10px;
  }

  button {
    flex: 1;
    padding: 15px;
    font-size: 1.2rem;
    cursor: pointer;
  }

  #log {
    font-size: 0.9rem;
    text-align: left;
    max-height: 200px;
    overflow-y: auto;
    border-top: 1px solid #333;
    padding-top: 10px;
  }
</style>

</head>
<body>

  


  <div id="container">
    <div id="time">--:--:--</div>

    <div id="controls">
      <input
        type="number"
        id="riderNumber"
        placeholder="Číslo závodníka"
      />

      <div class="buttons">
        <button id="startBtn">START</button>
        <button id="finishBtn">CÍL</button>
        <button id="reset">Reset závodu</button>
      </div>
    </div>

    <div id="log"></div>
    <h3>Výsledky</h3>
    <div id="results"></div>

  </div>

  <script src="app.js"></script>
</body>

</html>
